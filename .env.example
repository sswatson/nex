# Backend for tutoring and grading (optional):
#   claude-code (default) — shell out to the Claude Code CLI headlessly.
#     Uses your Claude subscription login (`claude` → /login); no API key needed.
#   api — call the Anthropic API directly; requires ANTHROPIC_API_KEY below.
# NEX_BACKEND=claude-code

# Only needed with NEX_BACKEND=api.
# ANTHROPIC_API_KEY=sk-ant-...

# Model for tutoring and grading (optional)
NEX_MODEL=claude-opus-4-8

# Reasoning effort: low | medium | high | xhigh | max (optional, default low).
# 'low' roughly halves time-to-first-token for chat replies; raise it if
# grading or explanations feel shallow.
# NEX_EFFORT=low
